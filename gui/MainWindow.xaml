<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC TuneUp" Width="1060" Height="780" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentLight" Color="#EBF3FC"/>
    <SolidColorBrush x:Key="TextMain" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>

    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <Style x:Key="GroupExpander" TargetType="Expander">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ヘッダー -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="PC TuneUp" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
        <TextBlock Name="HeaderSub" Text="Windows 11 の不要ファイル・設定・セキュリティを点検して修復します。無料・追加インストール不要。"
                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
      <TextBlock Name="AdminBadge" Grid.Column="1" VerticalAlignment="Top" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="12,4,0,0"/>
    </Grid>

    <!-- カテゴリ カード -->
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,-12,12">
      <Button Name="CatTuneup" Style="{StaticResource CardButton}" Tag="tuneup">
        <Grid>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Name="CatTuneupGlyph" FontFamily="Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="PC の調整" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock Name="CatTuneupText" Text="未スキャン" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Name="CatTuneupBadge" Background="#D13438" CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="Collapsed">
            <TextBlock Name="CatTuneupBadgeText" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
        </Grid>
      </Button>
      <Button Name="CatInternet" Style="{StaticResource CardButton}" Tag="internet">
        <Grid>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Name="CatInternetGlyph" FontFamily="Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="インターネット" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock Name="CatInternetText" Text="未スキャン" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Name="CatInternetBadge" Background="#D13438" CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="Collapsed">
            <TextBlock Name="CatInternetBadgeText" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
        </Grid>
      </Button>
      <Button Name="CatSecurity" Style="{StaticResource CardButton}" Tag="security">
        <Grid>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Name="CatSecurityGlyph" FontFamily="Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="マルウェアとセキュリティ" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock Name="CatSecurityText" Text="未スキャン" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Name="CatSecurityBadge" Background="#D13438" CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="Collapsed">
            <TextBlock Name="CatSecurityBadgeText" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
        </Grid>
      </Button>
    </UniformGrid>

    <!-- カテゴリ説明 -->
    <TextBlock Name="CategoryBlurb" Grid.Row="2" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="2,0,0,10"/>

    <!-- グループ一覧 -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="GroupsPanel" Margin="0,0,6,0"/>
    </ScrollViewer>

    <!-- 操作ボタン -->
    <Grid Grid.Row="4" Margin="0,12,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Name="ScanButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="スキャン" MinWidth="120"/>
      <Button Name="FixButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="選択した項目を修復" MinWidth="150" Margin="8,0,0,0" IsEnabled="False"/>
      <Button Name="CancelButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="中止" Margin="8,0,0,0" Visibility="Collapsed"/>
      <CheckBox Name="FullScanBox" Grid.Column="3" Content="詳細スキャン (DISM・ディスク検査・更新の確認など、時間のかかる項目も含める)"
                VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextMuted}"/>
      <Button Name="SelectAllButton" Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="すべて選択" Margin="8,0,0,0" Padding="12,6"/>
      <Button Name="SelectNoneButton" Grid.Column="5" Style="{StaticResource SecondaryButton}" Content="選択解除" Margin="8,0,0,0" Padding="12,6"/>
      <Button Name="ReportButton" Grid.Column="6" Style="{StaticResource SecondaryButton}" Content="レポート保存" Margin="8,0,0,0" Padding="12,6" IsEnabled="False"/>
    </Grid>

    <!-- 進捗とログ -->
    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ProgressBar Name="Progress" Height="4" Minimum="0" Maximum="100" Visibility="Hidden" Foreground="{StaticResource Accent}" BorderThickness="0" Background="#E5E7EB"/>
      <TextBlock Name="StatusText" Grid.Row="1" Foreground="{StaticResource TextMuted}" Margin="2,6,0,4" TextWrapping="Wrap"/>
      <Expander Grid.Row="2" Name="LogExpander" Header="ログ" IsExpanded="False" Foreground="{StaticResource TextMuted}">
        <TextBox Name="LogBox" Height="140" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, MS Gothic" FontSize="11"
                 Background="White" BorderBrush="{StaticResource Border}" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
      </Expander>
    </Grid>
  </Grid>
</Window>
